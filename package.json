{
  "name": "ctrlem-db",
  "version": "2.0.2",
  "private": true,
  "description": "CtrlEm DB browser extension by Strateg",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run lint:firefox",
    "build:firefox": "node scripts/build.mjs --firefox",
    "build:amo": "node scripts/build-amo.mjs",
    "sign:firefox": "node scripts/sign-firefox.mjs",
    "verify:amo": "node scripts/verify-amo.mjs",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/resize-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "web-ext": "10.7.0"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "0.0.43",
    "zod": "4.6.5"
  },
  "license": "MIT",
  "author": "Strateg"
}
